# MetaPilot AI - Backend Environment Configuration Example
# Copy this file to .env and provide your values. Never commit .env.

# Application Configuration
APP_ENV=development
APP_NAME="MetaPilot AI Engine"
PORT=8000
DEBUG=true

# Mode Toggle: Set to 'demo' to run fully offline with transparent synthetic data
# Set to 'connected' to use live Meta Graph and OpenAI APIs
EXECUTION_MODE=demo

# Supabase Authentication & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# Meta Ads API (v19.0+)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-system-user-or-user-access-token
META_AD_ACCOUNT_ID=act_1234567890
META_INSTAGRAM_ACCOUNT_ID=17841400000000000

# OpenAI & AI Agents
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Security Guardrails
REQUIRE_EXPLICIT_APPROVAL=true
DEFAULT_CAMPAIGN_STATUS=PAUSED
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
